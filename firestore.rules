/**
 * This ruleset enforces a strict user-ownership model for a medical application,
 * with an exception for administrative users.
 *
 * Core Philosophy:
 * The security model is built on the principle that a user can only access their
 * own data. All operations (read, create, update, delete) are restricted to the
 * authenticated owner of a document, ensuring patient and professional data privacy.
 * Admin users, identified by a custom claim, are granted read-only access to all
 * user data for management purposes.
 *
 * Data Structure:
 * The data is organized in a single top-level collection: `/medicalProfessionals`.
 * Each document in this collection is identified by a medical professional's
 * Firebase Authentication UID. This structure avoids the need for extra database
 * reads (`get()` calls) within the rules, leading to better performance and
 * simpler, more secure logic.
 *
 * Key Security Decisions:
 * - Admin Read-All: Admins can list and read all user profiles.
 * - No Public User Listing: Non-admin users cannot list other users.
 * - Strict Ownership for non-admins: All access is gated by matching the document ID with the
 *   requester's authentication UID.
 * - Self-Creation Only: A user can only create their own profile document.
 * - Immutable ID: The internal `id` field of a professional's document, which
 *   links to their UID, cannot be changed after creation, ensuring data integrity.
 *
 * Denormalization for Authorization:
 * This ruleset relies on the path structure for authorization. The document ID
 * `{medicalProfessionalId}` is the user's UID, which is the most efficient
 * way to secure user-owned data. The document data itself must contain an `id`
 * field that matches this UID, which is enforced on creation.
 *
 * Structural Segregation:
 * The design uses a single collection for user profiles, as there is no
 * distinction between public and private profile data in this model. All data
 *  is considered private to the owner, except for admins.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the user is an administrator via custom claims.
     */
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    /**
     * Checks if the requesting user's UID matches the provided userId.
     * This is the primary function for establishing document ownership.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Verifies ownership for an existing document. Used for update and delete
     * operations to prevent acting on non-existent documents.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates a create request for a user's own profile document.
     * Ensures the user is signed in and that the internal `id` field of the new
     * document correctly matches the user's UID (and the document path).
     * This establishes the critical link between the document and its owner.
     */
    function isCreatingSelf(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates an update request for a user's own profile document.
     * Ensures the user is the owner of an existing document and that the
     * internal `id` field is not being changed, preserving data integrity.
     */
    function isUpdatingOwnProfile(userId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id;
    }

    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Controls access to a medical professional's profile document.
     * @path        /medicalProfessionals/{medicalProfessionalId}
     * @allow       (get) An owner can read their own doc. An admin can read any doc.
     * @allow       (list) An admin can list all docs.
     * @allow       (update, delete) A logged-in user can modify their own document.
     * @allow       (create) A new user can create their own document.
     * @deny        (get) A non-admin user cannot read another user's document.
     * @deny        (list) A non-admin cannot list all documents.
     * @principle   Restricts access to a user's own data tree, with an exception for admins.
     */
    match /medicalProfessionals/{medicalProfessionalId} {
      // READ Rules: Owner can get their doc, admins can get any doc or list all.
      allow get: if isOwner(medicalProfessionalId) || isAdmin();
      allow list: if isAdmin();

      // WRITE Rules: Users can create, update, and delete ONLY their own document.
      allow create: if isCreatingSelf(medicalProfessionalId);
      allow update: if isUpdatingOwnProfile(medicalProfessionalId);
      allow delete: if isExistingOwner(medicalProfessionalId);
    }
  }
}
